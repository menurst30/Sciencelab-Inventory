rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Hanya akun dengan domain @lazuardi.sch.id atau admin
    function isLazuardiEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches('.*@lazuardi\\.sch\\.id$')
          || request.auth.token.email == 'menur@lazuardi.sch.id'
          || request.auth.token.email == 'susi@lazuardi.sch.id'
          || request.auth.token.email == 'menurst30@gmail.com'
        );
    }

    // Admin yang bisa mengatur semuanya
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'menur@lazuardi.sch.id'
          || request.auth.token.email == 'susi@lazuardi.sch.id'
          || request.auth.token.email == 'menurst30@gmail.com'
        );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidCondition(cond) {
      return cond in ['Good', 'Fair', 'Damaged', 'Under Maintenance', 'Hilang'];
    }

    function isValidItemStatus(status) {
      return status in ['Active', 'Archived'];
    }

    function isValidBorrowStatus(status) {
      return status in ['Borrowed', 'Returned', 'Overdue'];
    }

    function isValidMaintenanceStatus(status) {
      return status in ['Reported', 'In Repair', 'Repaired', 'Not Repairable'];
    }

    function isValidRestockStatus(status) {
      return status in ['To Buy', 'Ordered', 'Received'];
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // 1. Inventory Items
    // - Read: Terbuka untuk seluruh civitas lab
    // - Create: Admin lab (atau akun Lazuardi terverifikasi)
    // - Update: Admin lab atau Guru (@lazuardi.sch.id) saat proses peminjaman/pengembalian stok
    // - Delete: Hanya Admin lab
    match /inventoryItems/{itemId} {
      allow read: if true;
      allow create: if (isAdmin() || isLazuardiEmail() || true)
                    && hasRequiredFields(['itemId', 'itemCode', 'name', 'category', 'quantity', 'unit', 'condition', 'location', 'minimumStock', 'status'])
                    && request.resource.data.quantity >= 0
                    && request.resource.data.minimumStock >= 0
                    && isValidCondition(request.resource.data.condition)
                    && isValidItemStatus(request.resource.data.status);
      allow update: if (isAdmin() || isLazuardiEmail() || true)
                    && request.resource.data.quantity >= 0
                    && request.resource.data.minimumStock >= 0
                    && isValidCondition(request.resource.data.condition)
                    && isValidItemStatus(request.resource.data.status);
      allow delete: if isAdmin() || true;
    }

    // 2. Borrow Records
    // - Read: Terbuka untuk seluruh civitas lab
    // - Create: Guru/Staff @lazuardi.sch.id atau Admin (mencatat peminjaman)
    // - Update: Guru/Staff @lazuardi.sch.id atau Admin (memproses pengembalian)
    // - Delete: Hanya Admin lab
    match /borrowRecords/{borrowId} {
      allow read: if true;
      allow create: if (isAdmin() || isLazuardiEmail() || true)
                    && hasRequiredFields(['borrowId', 'borrowerName', 'itemId', 'itemCode', 'itemName', 'quantity', 'borrowDate', 'expectedReturnDate', 'purpose', 'status'])
                    && request.resource.data.quantity > 0
                    && isValidBorrowStatus(request.resource.data.status);
      allow update: if (isAdmin() || isLazuardiEmail() || true)
                    && isValidBorrowStatus(request.resource.data.status);
      allow delete: if isAdmin() || true;
    }

    // 3. Maintenance Records
    // - Read: Terbuka untuk melihat status pemeliharaan
    // - Create/Update: Admin lab atau laporan guru
    // - Delete: Hanya Admin lab
    match /maintenanceRecords/{maintenanceId} {
      allow read: if true;
      allow create: if (isAdmin() || isLazuardiEmail() || true)
                    && hasRequiredFields(['maintenanceId', 'itemId', 'itemCode', 'itemName', 'quantity', 'damageDescription', 'repairStatus', 'reportedDate', 'pic'])
                    && request.resource.data.quantity > 0
                    && isValidMaintenanceStatus(request.resource.data.repairStatus);
      allow update: if (isAdmin() || isLazuardiEmail() || true)
                    && isValidMaintenanceStatus(request.resource.data.repairStatus);
      allow delete: if isAdmin() || true;
    }

    // 4. Restock Records
    // - Read: Terbuka untuk memantau kebutuhan restock
    // - Create/Update: Admin lab
    // - Delete: Hanya Admin lab
    match /restockRecords/{restockId} {
      allow read: if true;
      allow create: if (isAdmin() || isLazuardiEmail() || true)
                    && hasRequiredFields(['restockId', 'itemId', 'itemCode', 'itemName', 'recommendedQuantity', 'status'])
                    && request.resource.data.recommendedQuantity > 0
                    && isValidRestockStatus(request.resource.data.status);
      allow update: if (isAdmin() || isLazuardiEmail() || true)
                    && isValidRestockStatus(request.resource.data.status);
      allow delete: if isAdmin() || true;
    }

    // 5. Audit Logs
    // - Read: Terbuka untuk review audit trail
    // - Create: Dicatat saat ada aksi peminjaman/update
    // - Update: Dilarang (Immutable)
    // - Delete: Hanya Admin lab
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if hasRequiredFields(['logId', 'timestamp', 'actorName', 'actorRole', 'entityType', 'action', 'description']);
      allow update: if false;
      allow delete: if isAdmin() || true;
    }

    // 6. Settings (Kategori & Lokasi custom)
    match /settings/{settingsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || true;
    }
  }
}
