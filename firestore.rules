rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidCondition(cond) {
      return cond in ['Good', 'Fair', 'Damaged', 'Under Maintenance', 'Hilang'];
    }

    function isValidItemStatus(status) {
      return status in ['Active', 'Archived'];
    }

    function isValidBorrowStatus(status) {
      return status in ['Borrowed', 'Returned', 'Overdue'];
    }

    function isValidMaintenanceStatus(status) {
      return status in ['Reported', 'In Repair', 'Repaired', 'Not Repairable'];
    }

    function isValidRestockStatus(status) {
      return status in ['To Buy', 'Ordered', 'Received'];
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Inventory Items
    match /inventoryItems/{itemId} {
      allow read: if true;
      allow create: if hasRequiredFields(['itemId', 'itemCode', 'name', 'category', 'quantity', 'unit', 'condition', 'location', 'minimumStock', 'status'])
                    && request.resource.data.quantity >= 0
                    && request.resource.data.minimumStock >= 0
                    && isValidCondition(request.resource.data.condition)
                    && isValidItemStatus(request.resource.data.status);
      allow update: if request.resource.data.quantity >= 0
                    && request.resource.data.minimumStock >= 0
                    && isValidCondition(request.resource.data.condition)
                    && isValidItemStatus(request.resource.data.status);
      allow delete: if true;
    }

    // Borrow Records
    match /borrowRecords/{borrowId} {
      allow read: if true;
      allow create: if hasRequiredFields(['borrowId', 'borrowerName', 'itemId', 'itemCode', 'itemName', 'quantity', 'borrowDate', 'expectedReturnDate', 'purpose', 'status'])
                    && request.resource.data.quantity > 0
                    && isValidBorrowStatus(request.resource.data.status);
      allow update: if isValidBorrowStatus(request.resource.data.status);
      allow delete: if true;
    }

    // Maintenance Records
    match /maintenanceRecords/{maintenanceId} {
      allow read: if true;
      allow create: if hasRequiredFields(['maintenanceId', 'itemId', 'itemCode', 'itemName', 'quantity', 'damageDescription', 'repairStatus', 'reportedDate', 'pic'])
                    && request.resource.data.quantity > 0
                    && isValidMaintenanceStatus(request.resource.data.repairStatus);
      allow update: if isValidMaintenanceStatus(request.resource.data.repairStatus);
      allow delete: if true;
    }

    // Restock Records
    match /restockRecords/{restockId} {
      allow read: if true;
      allow create: if hasRequiredFields(['restockId', 'itemId', 'itemCode', 'itemName', 'recommendedQuantity', 'status'])
                    && request.resource.data.recommendedQuantity > 0
                    && isValidRestockStatus(request.resource.data.status);
      allow update: if isValidRestockStatus(request.resource.data.status);
      allow delete: if true;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if hasRequiredFields(['logId', 'timestamp', 'actorName', 'actorRole', 'entityType', 'action', 'description']);
      allow update: if false; // Audit logs are immutable
      allow delete: if true;
    }

    // Settings (Categories, Locations)
    match /settings/{settingsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
